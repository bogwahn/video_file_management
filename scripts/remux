#!/bin/bash
# Wrapper for local repo usage without installation.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
VENV_PYTHON="${REPO_ROOT}/.venv/bin/python"

export PYTHONPATH="${REPO_ROOT}/src:${PYTHONPATH:-}"

if [ -x "${VENV_PYTHON}" ]; then
	exec "${VENV_PYTHON}" -m video_file_management.cli.remux2mp4 "$@"
fi

exec python3 -m video_file_management.cli.remux2mp4 "$@"
