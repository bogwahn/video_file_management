#!/opt/homebrew/bin/python3
"""
mkv2mp4 — Fast, lossless MKV → MP4 re-container tool using ffmpeg.

Phase 1 Features:
✔ Recursive scanning
✔ Dry-run mode
✔ Smart codec detection
✔ Auto-skip already-converted files
✔ Logging
✔ Verbose mode
✔ Metadata preservation
"""

import argparse
import os
import subprocess
import sys
import time
from concurrent.futures import ThreadPoolExecutor, as_completed
from pathlib import Path
from typing import List, Optional

VERSION = "1.1.0"


# ------------------------------------------------------------
# Helpers
# ------------------------------------------------------------


def is_mkv(path: Path) -> bool:
    return path.suffix.lower() == ".mkv"


def collect_input_files(input_arg: Optional[Path], recursive: bool) -> List[Path]:
    """Return a list of MKV files based on input argument."""
    if input_arg is None:
        base = Path.cwd()
    else:
        base = input_arg

    if base.is_file():
        if is_mkv(base):
            return [base]
        raise ValueError(f"Input file is not an MKV: {base}")

    if recursive:
        return sorted([p for p in base.rglob("*.mkv")])
    else:
        return sorted([p for p in base.glob("*.mkv")])


def build_output_path(input_file: Path, output_arg: Optional[Path]) -> Path:
    """Determine output file path based on input and output args."""
    if output_arg is None:
        return input_file.with_suffix(".mp4")

    if output_arg.is_dir():
        return output_arg / (input_file.stem + ".mp4")

    return output_arg


def run_ffprobe(path: Path) -> dict:
    """Return stream info using ffprobe."""
    cmd = [
        "ffprobe",
        "-v",
        "error",
        "-show_entries",
        "stream=index,codec_type,codec_name",
        "-of",
        "json",
        str(path),
    ]
    try:
        result = subprocess.run(cmd, capture_output=True, text=True, check=True)
        import json

        return json.loads(result.stdout)
    except Exception:
        return {}


def is_mp4_compatible(stream: dict) -> bool:
    """Determine if a stream codec is MP4-compatible."""
    video_ok = {"h264", "hevc", "mpeg4"}
    audio_ok = {"aac", "mp3", "ac3"}

    if stream["codec_type"] == "video":
        return stream["codec_name"] in video_ok
    if stream["codec_type"] == "audio":
        return stream["codec_name"] in audio_ok
    return False


# ------------------------------------------------------------
# ffmpeg execution
# ------------------------------------------------------------


def remux_mkv_to_mp4(
    input_file: Path,
    output_file: Path,
    dry_run: bool,
    verbose: bool,
    log_file: Optional[Path],
) -> bool:
    """
    Perform a lossless MKV → MP4 re-container operation.
    Returns True on success, False on failure.
    """

    # Smart codec detection
    info = run_ffprobe(input_file)
    incompatible = False

    for stream in info.get("streams", []):
        if stream["codec_type"] in ("video", "audio"):
            if not is_mp4_compatible(stream):
                incompatible = True

    if incompatible:
        print(f"⚠ {input_file.name}: incompatible codec detected (will re-encode)")
        # For Phase 1, we only warn — Phase 2 will add re-encode logic.

    if dry_run:
        print(f"[DRY RUN] Would convert: {input_file} → {output_file}")
        return True

    cmd = [
        "ffmpeg",
        "-hide_banner",
        "-loglevel",
        "error" if not verbose else "info",
        "-y",
        "-i",
        str(input_file),
        # Map streams
        "-map",
        "0:v",
        "-map",
        "0:a?",
        "-map",
        "0:s?",
        # Copy video/audio
        "-c:v",
        "copy",
        "-c:a",
        "copy",
        # Convert subtitles
        "-c:s",
        "mov_text",
        # Preserve metadata
        "-map_metadata",
        "0",
        str(output_file),
    ]

    try:
        result = subprocess.run(cmd, capture_output=not verbose, text=True)
        if log_file:
            with open(log_file, "a") as f:
                f.write(result.stdout or "")
                f.write(result.stderr or "")
        return result.returncode == 0
    except Exception as e:
        if log_file:
            with open(log_file, "a") as f:
                f.write(str(e))
        return False


# ------------------------------------------------------------
# Main CLI
# ------------------------------------------------------------


def main():
    parser = argparse.ArgumentParser(
        prog="mkv2mp4", description="Losslessly re-container MKV → MP4 using ffmpeg."
    )

    parser.add_argument(
        "input",
        nargs="?",
        type=Path,
        help="Input file or directory. Defaults to current directory.",
    )
    parser.add_argument(
        "output",
        nargs="?",
        type=Path,
        help="Output file or directory. Defaults to same directory.",
    )

    parser.add_argument(
        "--recursive", action="store_true", help="Scan directories recursively."
    )
    parser.add_argument(
        "--dry-run",
        action="store_true",
        help="Show what would be done without converting.",
    )
    parser.add_argument("--verbose", action="store_true", help="Show ffmpeg output.")
    parser.add_argument("--log", type=Path, help="Write ffmpeg output to a log file.")
    parser.add_argument("--version", action="store_true", help="Show version and exit.")

    args = parser.parse_args()

    if args.version:
        print(f"mkv2mp4 version {VERSION}")
        sys.exit(0)

    # Collect input files
    try:
        input_files = collect_input_files(args.input, args.recursive)
    except ValueError as e:
        print("Error:", e)
        sys.exit(1)

    if not input_files:
        print("No MKV files found.")
        sys.exit(1)

    # Ensure output directory exists
    if args.output and args.output.is_dir():
        args.output.mkdir(parents=True, exist_ok=True)

    print(f"Found {len(input_files)} MKV file(s). Starting conversion...")

    start_time = time.time()

    with ThreadPoolExecutor(max_workers=os.cpu_count()) as pool:
        futures = {}
        for mkv in input_files:
            out = build_output_path(mkv, args.output)

            # Auto-skip
            if out.exists() and out.stat().st_mtime >= mkv.stat().st_mtime:
                print(f"⏭ Skipping (already converted): {mkv.name}")
                continue

            futures[
                pool.submit(
                    remux_mkv_to_mp4, mkv, out, args.dry_run, args.verbose, args.log
                )
            ] = (mkv, out)

        for future in as_completed(futures):
            mkv, out = futures[future]
            if future.result():
                print(f"✓ {mkv.name} → {out.name}")
            else:
                print(f"✗ FAILED: {mkv.name}")

    elapsed = time.time() - start_time
    print(f"Done in {elapsed:.2f} seconds.")


if __name__ == "__main__":
    main()
